{
  "$comment": "Authoritative cases for the style projection (`reticle ui style`), read by BOTH the Kotlin (reticle-core StyleObservationTest) and Swift (ReticleProtocol StyleObservationTests) suites, so the Android helper and the iOS host cannot render the same snapshot differently. Each case is a snapshot plus the exact lines StyleObservation.render() must produce. The projection is evidence, never a verdict: it reports magnitudes, the channel each came through, and the properties no channel can read — what the values ought to be, what tolerance counts and which regions are exempt are the consumer's policy. Note what the cases pin: Android lengths are physical pixels and convert to dp; iOS lengths are points and must NOT be divided again (the density-double-scaling trap); an sp figure needs fontScale and says so when it is missing; a value whose unit is unknown (computed CSS) passes through verbatim; and a gap is rendered by name with its reason rather than being absent.",
  "cases": [
    {
      "name": "android: px lengths convert to dp, and to sp once fontScale is known (and alpha=1.0 is dropped as saying nothing)",
      "snapshot": {
        "schemaVersion": 1,
        "capturedAtMillis": 1719400000000,
        "platform": "android",
        "screen": { "size": { "width": 1080, "height": 2400 }, "density": 3.0, "fontScale": 1.0 },
        "rootRef": "r0",
        "nodes": {
          "r0": {
            "ref": "r0",
            "kind": "application",
            "typeName": "android.app.Application",
            "role": "application",
            "children": ["r1"]
          },
          "r1": {
            "ref": "r1",
            "parentRef": "r0",
            "kind": "view",
            "typeName": "android.widget.Button",
            "role": "button",
            "text": "Pay now",
            "testId": "checkout.payButton",
            "frame": { "x": 24, "y": 1800, "width": 1032, "height": 120 },
            "custom": {
              "textSize": { "_type": "real", "value": 42.0 },
              "textColor": { "_type": "text", "value": "#FF202124" },
              "fontWeight": { "_type": "int", "value": 600 },
              "paddingLeft": { "_type": "real", "value": 48.0 },
              "cornerRadius": { "_type": "real", "value": 24.0 },
              "alpha": { "_type": "real", "value": 1.0 },
              "tag": { "_type": "text", "value": "not-style" }
            },
            "styleChannels": {
              "textSize": "viewField",
              "textColor": "viewField",
              "fontWeight": "viewField",
              "paddingLeft": "viewField",
              "cornerRadius": "drawableReflect",
              "alpha": "viewField"
            }
          }
        }
      },
      "expect": [
        "screen: 1080x2400px density=3 fontScale=1 -> 360x800dp",
        "#checkout.payButton button \"Pay now\"",
        "    frame  24,1800 1032x120px | 8,600 344x40dp | 95.6%x5% of screen",
        "    cornerRadius  24px | 8dp  [drawableReflect]",
        "    fontWeight    600  [viewField]",
        "    paddingLeft   48px | 16dp  [viewField]",
        "    textColor     #FF202124  [viewField]",
        "    textSize      42px | 14dp | 14sp  [viewField]"
      ]
    },
