#!/usr/bin/env bash
#
# Reticle from THIS source tree, for developing Reticle itself.
#
# An installed Reticle does not use this file: `install.sh` puts the release on
# PATH as ~/.local/bin/reticle and `reticle update` switches releases (see
# README.md -> "How the CLI is obtained"). This launcher builds what changed —
# the native helper (gradle + GraalVM native-image), reticle-device (cargo, if
# present) and the Swift host — then execs the host with the helper beside it.
# macOS arm64 only. RETICLE_FROM_SOURCE=1 is accepted and no longer needed.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GRADLEW="${ROOT}/gradlew"
SRC_HOST_BIN="${ROOT}/reticle-host/.build/release/ReticleHost"
SRC_HELPER_BIN="${ROOT}/reticle-helper/build/native/reticle-helper"

log() { echo "reticle: $*" >&2; }

exec_host() {
  local host="$1"; shift
  local helper="$1"; shift
  if [[ -n "${helper}" && -x "${helper}" ]]; then
    RETICLE_HELPER="${helper}" exec "${host}" "$@"
  else
    exec "${host}" "$@"
  fi
}

# Is ${1} missing, or older than any source file under the remaining arguments?
#
# The whole point of this launcher is "run what is in this tree", and the
# check used to be `-x` alone: a binary left over from an earlier build was
# exec'd unchanged, so an edited tree ran the OLD code while the flag said
# otherwise. Measured: a host built hours earlier answered `reticle version` with
# `0.16.0` in a tree whose VERSION said 0.17.0, and it drove a device for a while
# before the mismatch was noticed — every observation from it attributed to code
# that was never running.
stale_against() {
  local target="$1"; shift
  [[ -x "${target}" ]] || return 0
  local dir
  for dir in "$@"; do
    [[ -e "${dir}" ]] || continue
    if [[ -n "$(find "${dir}" -type f -newer "${target}" -print -quit 2>/dev/null)" ]]; then
      return 0
    fi
  done
  return 1
}

if stale_against "${SRC_HELPER_BIN}" \
  "${ROOT}/reticle-helper/src" "${ROOT}/reticle-core/src" "${ROOT}/reticle-agent/android/src" \
  "${ROOT}/reticle-protocol" "${ROOT}/gradle/libs.versions.toml"; then
  if [[ ! -x "${GRADLEW}" ]]; then
    log "no gradlew at ${GRADLEW} (install from the full repo)."
    exit 1
  fi
  log "building the native helper from source (needs a GraalVM with native-image)…"
  ( cd "${ROOT}" && ./gradlew --quiet :reticle-helper:nativeHelper :reticle-agent:android:dexPayload ) >&2
fi
# reticle-device (the iOS real-device system channel) is Rust. Optional: without
# cargo the rest of the CLI still works and `system` says what is missing.
if command -v cargo >/dev/null 2>&1; then
  ( cd "${ROOT}" && cargo build --quiet --release --manifest-path reticle-device/Cargo.toml ) >&2 \
    || log "reticle-device did not build; \`system\` on a real iOS device needs it (or --via runner)."
fi
# The Swift build is its own incremental check and a no-op costs about a second,
# so it always runs rather than being guarded by timestamps.
if command -v swift >/dev/null 2>&1; then
  log "building the Swift host from source…"
  ( cd "${ROOT}/reticle-host" && swift build -c release ) >&2
elif [[ ! -x "${SRC_HOST_BIN}" ]]; then
  log "\`swift\` is not on PATH (needed to build the host)."
  exit 1
else
  log "\`swift\` is not on PATH — running the host already in the tree, which may be stale."
fi
if [[ ! -x "${SRC_HOST_BIN}" ]]; then
  log "source build did not produce ${SRC_HOST_BIN}"
  exit 1
fi
# A source build must not report a different release than the tree it came from.
# Hard-stop rather than warn: a version skew here means the binary is not this
# tree's code, and every answer it gives would be attributed to code that is.
if [[ -f "${ROOT}/VERSION" ]]; then
  _tree_version="$(tr -d '[:space:]' < "${ROOT}/VERSION")"
  _built_version="$(RETICLE_NO_UPDATE_CHECK=1 "${SRC_HOST_BIN}" version 2>/dev/null | awk '{print $NF}')"
  if [[ -n "${_tree_version}" && -n "${_built_version}" && "${_tree_version}" != "${_built_version}" ]]; then
    log "the host built from this tree reports ${_built_version} but VERSION says ${_tree_version}."
    log "That binary is not this tree's code. Rebuild it:"
    log "  ( cd ${ROOT}/reticle-host && rm -rf .build && swift build -c release )"
    exit 1
  fi
fi
exec_host "${SRC_HOST_BIN}" "${SRC_HELPER_BIN}" "$@"
