<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The loopback server needs INTERNET to open a 127.0.0.1 socket. The `linked`
      flavor inherits this from the agent AAR's manifest; the `noagent` flavor must
      declare it itself so an INJECTED server can bind. Real-world targets (e.g.
      easypln) already hold INTERNET — this keeps the test target honest.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Declared only so the permission scenario can raise a REAL system prompt — the
      one on-screen thing an in-process agent structurally cannot capture.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="Reticle Sample"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        <activity
            android:name="dev.reticle.sample.MainActivity"
            android:label="Reticle Sample"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.reticle.sample.CheckoutScenarioActivity"
            android:exported="false"
            android:label="Checkout Controls" />
        <activity
            android:name="dev.reticle.sample.AgreementScenarioActivity"
            android:exported="false"
            android:label="Agreement Regions" />
        <activity
            android:name="dev.reticle.sample.PermissionScenarioActivity"
            android:exported="false"
            android:label="System Permission Prompt" />
        <activity
            android:name="dev.reticle.sample.WebJsDialogScenarioActivity"
            android:exported="false"
            android:label="Web JS Dialog" />
        <activity
            android:name="dev.reticle.sample.PopupScenarioActivity"
            android:exported="false"
            android:label="Popup Windows" />
        <activity
            android:name="dev.reticle.sample.WheelPickerScenarioActivity"
            android:exported="false"
            android:label="Wheel Picker" />
        <activity
            android:name="dev.reticle.sample.CompoundFieldScenarioActivity"
            android:exported="false"
            android:label="Compound Fields" />
        <activity
            android:name="dev.reticle.sample.ReformattingFieldScenarioActivity"
            android:exported="false"
            android:label="Reformatting Fields" />
        <activity
            android:name="dev.reticle.sample.ToastScenarioActivity"
            android:exported="false"
            android:label="Toasts" />
        <activity
            android:name="dev.reticle.sample.ListScenarioActivity"
            android:exported="false"
            android:label="Long List" />
        <activity
            android:name="dev.reticle.sample.ComposeScenarioActivity"
            android:exported="false"
            android:label="Compose Semantics" />
        <activity
            android:name="dev.reticle.sample.CanvasControlScenarioActivity"
            android:exported="false"
            android:label="Canvas Control Regions" />
        <activity
            android:name="dev.reticle.sample.WebViewScenarioActivity"
            android:exported="false"
            android:label="WebView DOM"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />
        <activity
            android:name="dev.reticle.sample.LoginScenarioActivity"
            android:exported="false"
            android:label="Login Keyboard Trap" />
        <activity
            android:name="dev.reticle.sample.SystemDialogScenarioActivity"
            android:exported="false"
            android:label="System Dialog" />
        <activity
            android:name="dev.reticle.sample.LottieDialogScenarioActivity"
            android:exported="false"
            android:label="Lottie Dialog" />
        <activity
            android:name="dev.reticle.sample.WebLottieDialogScenarioActivity"
